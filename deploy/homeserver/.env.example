# Homeserver runtime config. Lives at ~/reclaim/.env on the server (chmod 600).
# install.sh creates it from this file and fills the two generated secrets.
# After editing, apply with:  ssh homelab '~/reclaim/bin/deploy.sh apply'

# ── Host ─────────────────────────────────────────────────────────────────────
IMAGE_REGISTRY=ghcr.io/michaelzhngg/paypal
HTTP_PORT=8080
# The URL people open. Used for CORS and PayPal OAuth/webhook callbacks.
PUBLIC_URL=https://CHANGE_ME.ts.net
# Uncomment both once the Cloudflare tunnel exists (see docs/deployment/homeserver.md).
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Database (generated) ─────────────────────────────────────────────────────
POSTGRES_USER=reclaim
POSTGRES_DB=smart_reimburse
POSTGRES_PASSWORD=GENERATED

# ── Backend ──────────────────────────────────────────────────────────────────
SECRET_KEY=GENERATED

# OpenRouter: vision, embeddings, the chat fallback, and (below) the main chat model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Main chat model (any OpenAI-compatible endpoint). Must come after OPENROUTER_API_KEY.
# To switch to Google's Gemini API directly, replace these three lines with:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<key from aistudio.google.com/apikey>
#   CHAT_MODEL=<Gemini model id without the "google/" prefix>
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=${OPENROUTER_API_KEY}
CHAT_MODEL=google/gemini-3.8-flash
VISION_MODEL=qwen/qwen3.5-flash-02-23
EMBEDDING_MODEL=openai/text-embedding-3-small

# PayPal sandbox. Keep mock mode on until the keys below are filled in.
PAYPAL_MOCK_MODE=true
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEB_URL=https://www.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=MYR

AUTO_REIMBURSE_ENABLED=true
VAPID_CLAIMS_EMAIL=reclaim@reclaimai.dev

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=reclaim_pay
