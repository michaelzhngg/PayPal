# Homeserver runtime config. Lives at ~/reclaim/.env on the server (chmod 600).
# install.sh creates it from this file and fills the two generated secrets.
# After editing, apply with:  ssh homelab '~/reclaim/bin/deploy.sh apply'

# ── Host ─────────────────────────────────────────────────────────────────────
IMAGE_REGISTRY=ghcr.io/michaelzhngg/paypal
HTTP_PORT=8080
# The URL people open. Used for CORS and PayPal OAuth/webhook callbacks.
PUBLIC_URL=https://CHANGE_ME.ts.net
# Uncomment both once the Cloudflare tunnel exists (see docs/deployment/homeserver.md).
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Database (generated) ─────────────────────────────────────────────────────
POSTGRES_USER=reclaim
POSTGRES_DB=smart_reimburse
POSTGRES_PASSWORD=GENERATED

# ── Backend ──────────────────────────────────────────────────────────────────
SECRET_KEY=GENERATED

LLM_API_KEY=
LLM_BASE_URL=https://api.ilmu.ai/v1
CHAT_MODEL=ilmu-glm-5.1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen/qwen3.5-flash-02-23
EMBEDDING_MODEL=openai/text-embedding-3-small

# PayPal sandbox. Keep mock mode on until the keys below are filled in.
PAYPAL_MOCK_MODE=true
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEB_URL=https://www.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=MYR

AUTO_REIMBURSE_ENABLED=true
VAPID_CLAIMS_EMAIL=reclaim@reclaimai.dev

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=reclaim_pay
